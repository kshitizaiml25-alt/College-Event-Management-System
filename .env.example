# Environment Variables — CampusHub
# Copy this file to .env.local and fill in real values before deploying.
# NEVER commit .env.local to version control.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CampusHub

# Auth (replace localStorage with real auth — e.g., NextAuth.js)
NEXTAUTH_SECRET=replace-with-a-random-32-char-secret
NEXTAUTH_URL=http://localhost:3000

# Database (e.g., MongoDB Atlas or PostgreSQL on Railway/Supabase)
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/campushub

# Email (e.g., Resend, SendGrid, Nodemailer)
EMAIL_FROM=hello@campushub.in
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional: Google Forms base URL for event registrations
NEXT_PUBLIC_GOOGLE_FORMS_BASE=https://forms.gle
